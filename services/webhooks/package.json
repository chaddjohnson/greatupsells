{
  "name": "greatupsells-webhooks-service",
  "version": "0.0.0",
  "scripts": {
    "format": "find src -type f -iname '*.js' -exec eslint --fix {} +",
    "lint": "eslint src/**/*.js",
    "destroy": "cd infrastructure && ./destroy.sh",
    "start": "nodemon -e js --exec \"serverless offline start --useWorkerThreads --allowCache --noPrependStageInUrl\" --watch src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neatowebsolutions/greatupsells.git"
  },
  "homepage": "https://github.com/neatowebsolutions/greatupsells/tree/master/services/webhooks#readme",
  "license": "UNLICENSED",
  "author": "Chad Johnson <chad.d.johnson@gmail.com>",
  "dependencies": {
    "@middy/core": "^1.0.0",
    "@middy/http-cors": "^1.0.0",
    "@greatupsells/gateway-http-client": "0.0.0",
    "@greatupsells/logger": "0.0.0",
    "dotenv": "^8.2.0",
    "dotenv-expand": "^5.1.0",
    "http-status-codes": "^2.1.4",
    "shopify-hmac-validation": "^1.1.1"
  },
  "devDependencies": {
    "nodemon": "^2.0.7",
    "serverless": "^3.19.0",
    "serverless-offline": "^8.8.0",
    "serverless-plugin-monorepo": "^0.10.0",
    "serverless-plugin-warmup": "^7.1.0"
  }
}
