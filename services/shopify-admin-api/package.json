{
  "name": "greatupsells-shopify-admin-api",
  "version": "0.0.0",
  "scripts": {
    "format": "find src -type f -iname '*.js' -exec eslint --fix {} +",
    "lint": "eslint src/**/*.js",
    "infrastructure": "cd infrastructure && ./run.sh",
    "destroy": "cd infrastructure && ./destroy.sh",
    "start": "nodemon -e js --exec \"NODE_TLS_REJECT_UNAUTHORIZED='0' serverless offline start --reloadHandler --noPrependStageInUrl\" --watch src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chaddjohnson/greatupsells.git"
  },
  "author": "Chad Johnson <chad.d.johnson@gmail.com>",
  "license": "UNLICENSED",
  "homepage": "https://github.com/chaddjohnson/greatupsells/tree/master/services/shopify-admin-api",
  "dependencies": {
    "@middy/core": "^1.0.0",
    "@middy/http-cors": "^1.0.0",
    "@greatupsells/gateway-http-client": "0.0.0",
    "@greatupsells/logger": "0.0.0",
    "http-status-codes": "^2.1.4",
    "jsonwebtoken": "^8.5.1",
    "querystringify": "^2.2.0"
  },
  "devDependencies": {
    "nodemon": "^2.0.7",
    "serverless": "^3.38.0",
    "serverless-domain-manager": "6.0.3",
    "serverless-offline": "^13.5.0",
    "serverless-plugin-monorepo": "^0.11.0",
    "serverless-plugin-warmup": "^8.2.1"
  }
}
