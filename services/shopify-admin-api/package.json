  "homepage": "https://github.com/neatowebsolutions/greatupsells/tree/master/services/shopify-admin-api",
  "dependencies": {
    "@middy/core": "^1.0.0",
    "@middy/http-cors": "^1.0.0",
    "@greatupsells/http-client": "0.0.0",
    "@greatupsells/logger": "0.0.0",
    "aws4-axios": "^2.2.0",
    "axios": "^0.21.1",
    "http-status-codes": "^2.1.4",
    "jsonwebtoken": "^8.5.1",
    "querystringify": "^2.2.0"
  },
  "devDependencies": {
    "nodemon": "^2.0.7",
    "serverless": "^2.43.1",
