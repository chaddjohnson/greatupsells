{
  "name": "upselling-shops-service",
  "version": "0.0.0",
  "scripts": {
    "lint": "eslint src/**/*.js",
    "format": "find src -type f -iname '*.js' -exec eslint --fix {} +",
    "migration": "migrate-mongo",
    "start": "nodemon -e js --exec \"serverless offline start --useWorkerThreads --allowCache --noPrependStageInUrl\" --watch src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neatowebsolutions/upselling.git"
  },
  "author": "Chad Johnson <chad@neatowebsolutions.com>",
  "license": "UNLICENSED",
  "homepage": "https://github.com/neatowebsolutions/upselling/tree/master/services/shops",
  "dependencies": {
    "@chaddjohnson/mongodb-client-lambda": "^2.1.0",
    "@neatowebsolutions/upselling-logger": "0.0.0",
    "bluebird": "^3.7.2",
    "geoip-country": "^4.0.56",
    "getenv": "^1.0.0",
    "glob-to-regexp": "^0.4.1",
    "http-status-codes": "^2.1.4",
    "lodash": "^4.17.15",
    "luxon": "^1.27.0",
    "mongoose": "^5.13.9",
    "mongoose-int32": "^0.4.1",
    "promise-retry": "^2.0.1",
    "saslprep": "^1.0.3",
    "shopify-api-node": "^3.6.5"
  },
  "devDependencies": {
    "aws-sdk": "^2.984.0",
    "nodemon": "^2.0.7",
    "serverless": "^2.43.1",
    "serverless-domain-manager": "neatowebsolutions/serverless-domain-manager",
    "serverless-offline": "^7.0.0",
    "serverless-plugin-conditional-functions": "^1.0.6",
    "serverless-plugin-monorepo": "^0.10.0"
  }
}
