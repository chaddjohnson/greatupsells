{
  "name": "greatupsells-shops-api",
  "version": "0.0.0",
  "scripts": {
    "lint": "eslint src/**/*.js",
    "format": "find src -type f -iname '*.js' -exec eslint --fix {} +",
    "migrate": "migrate-mongo up",
    "destroy": "cd infrastructure && ./destroy.sh",
    "start": "nodemon -e js --exec \"serverless offline start --useWorkerThreads --allowCache --noPrependStageInUrl\" --watch src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neatowebsolutions/greatupsells.git"
  },
  "author": "Chad Johnson <chad@neatowebsolutions.com>",
  "license": "UNLICENSED",
  "homepage": "https://github.com/neatowebsolutions/greatupsells/tree/master/services/shops-api",
  "dependencies": {
    "@chaddjohnson/mongodb-client-lambda": "^2.1.0",
    "@greatupsells/logger": "0.0.0",
    "bluebird": "^3.7.2",
    "geoip-country": "^4.0.56",
    "getenv": "^1.0.0",
    "glob-to-regexp": "^0.4.1",
    "http-status-codes": "^2.1.4",
    "lodash": "^4.17.15",
    "luxon": "^1.27.0",
    "migrate-mongo": "^8.2.3",
    "mongoose": "^5.13.9",
    "mongoose-int32": "^0.4.1",
    "promise-retry": "^2.0.1",
    "saslprep": "^1.0.3",
    "shopify-api-node": "^3.6.5"
  },
  "devDependencies": {
    "aws-sdk": "^2.1032.0",
    "nodemon": "^2.0.7",
    "serverless": "^2.43.1",
    "serverless-domain-manager": "git+https://github.com/neatowebsolutions/serverless-domain-manager.git#166aff6a8bcb09047e344e1fd6d67638bbfaeaed",
    "serverless-offline": "^8.3.1",
    "serverless-plugin-conditional-functions": "^1.0.6",
    "serverless-plugin-monorepo": "^0.10.0",
    "serverless-plugin-warmup": "^5.3.1"
  }
}
