{
  "name": "greatupsells-shops-api",
  "version": "0.0.0",
  "scripts": {
    "lint": "eslint src/**/*.js",
    "format": "find src -type f -iname '*.js' -exec eslint --fix {} +",
    "migrate": "migrate-mongo up",
    "infrastructure": "cd infrastructure && ./run.sh",
    "destroy": "cd infrastructure && ./destroy.sh",
    "start": "nodemon -e js --exec \"NODE_TLS_REJECT_UNAUTHORIZED='0' serverless offline start --reloadHandler --noPrependStageInUrl\" --watch src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chaddjohnson/greatupsells.git"
  },
  "author": "Chad Johnson <chad.d.johnson@gmail.com>",
  "license": "UNLICENSED",
  "homepage": "https://github.com/chaddjohnson/greatupsells/tree/master/services/shops-api",
  "dependencies": {
    "@chaddjohnson/mongodb-client-lambda": "^2.1.0",
    "@greatupsells/email-client": "0.0.0",
    "@greatupsells/logger": "0.0.0",
    "@shopify/admin-api-client": "^1.0.5",
    "bluebird": "^3.7.2",
    "geoip-country": "^4.0.56",
    "getenv": "^1.0.0",
    "glob-to-regexp": "^0.4.1",
    "http-status-codes": "^2.1.4",
    "lodash": "^4.17.15",
    "luxon": "^1.27.0",
    "migrate-mongo": "^8.2.3",
    "mongoose": "^5.13.9",
    "mongoose-int32": "^0.4.1",
    "promise-retry": "^2.0.1",
    "saslprep": "^1.0.3",
    "shopify-api-node": "^3.6.5"
  },
  "devDependencies": {
    "aws-sdk": "^2.1692.0",
    "serverless": "^3.38.0",
    "serverless-domain-manager": "6.0.3",
    "serverless-offline": "^13.5.0",
    "serverless-plugin-conditional-functions": "^1.0.6",
    "serverless-plugin-monorepo": "^0.11.0",
    "serverless-plugin-warmup": "^8.2.1"
  }
}
