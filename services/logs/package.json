{
  "name": "upselling-logs-service",
  "version": "0.0.0",
  "scripts": {
    "lint": "eslint src/**/*.js",
    "format": "find src -type f -iname '*.js' -exec eslint --fix {} +",
    "migration": "migrate-mongo",
    "infrastructure": "./scripts/infrastructure.sh",
    "start": "nodemon -e js --exec \"serverless offline start --useWorkerThreads --allowCache --noPrependStageInUrl\" --watch src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neatowebsolutions/upselling.git"
  },
  "author": "Chad Johnson <chad@neatowebsolutions.com>",
  "license": "UNLICENSED",
  "homepage": "https://github.com/neatowebsolutions/upselling/tree/master/services/logs",
  "dependencies": {
    "@chaddjohnson/mongodb-client-lambda": "^2.0.2",
    "@neatowebsolutions/upselling-logger": "0.0.0",
    "@elastic/elasticsearch": "~7.10.0",
    "@middy/core": "^1.0.0",
    "@middy/http-cors": "^1.0.0",
    "bluebird": "^3.7.2",
    "http-status-codes": "^2.1.4",
    "migrate-mongo": "^8.1.4",
    "mongoose": "^5.13.9"
  },
  "devDependencies": {
    "aws-sdk": "^2.984.0",
    "nodemon": "^2.0.7",
    "serverless": "^2.43.1",
    "serverless-domain-manager": "^5.1.5",
    "serverless-offline": "^7.0.0",
    "serverless-plugin-monorepo": "^0.10.0"
  }
}
