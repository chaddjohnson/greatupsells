{
  "name": "root",
  "private": true,
  "workspaces": [
    "applications/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "lint": "lerna run lint",
    "format": "lerna run format",
    "clean": "find . -iname node_modules -exec rm -rf {} + ; rm -rf applications/*/.next packages/*/dist",
    "destroy": "dotenv -- bash -c 'lerna run destroy --stream && (cd infrastructure && ./destroy.sh)'",
    "bootstrap": "dotenv -- yarn workspaces focus --all",
    "postbootstrap": "dotenv -- lerna run build --stream --scope=@greatupsells/*",
    "prestart": "rm -f package-lock.json; yarn install --immutable && dotenv -- yarn bootstrap",
    "start": "(ngrok start greatupsells > /dev/null) & COLUMNS=120 dotenv -- lerna run start --parallel"
  },
  "author": "Chad Johnson <chad.d.johnson@gmail.com>",
  "license": "UNLICENSED",
  "homepage": "https://github.com/chaddjohnson/greatupsells",
  "dependencies": {
    "prop-types": "^15.7.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^5.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.8",
    "@babel/eslint-parser": "^7.26.8",
    "@babel/plugin-proposal-class-properties": "^7.12.1",
    "@babel/plugin-proposal-object-rest-spread": "^7.12.1",
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/plugin-transform-react-jsx": "^7.12.7",
    "@babel/plugin-transform-runtime": "^7.26.8",
    "@babel/preset-env": "^7.26.8",
    "@babel/preset-react": "^7.12.7",
    "babel-cli": "^6.26.0",
    "babel-loader": "^9.2.1",
    "clean-webpack-plugin": "^3.0.0",
    "dotenv-cli": "^4.0.0",
    "eslint": "^8.56.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-flowtype": "^8.0.3",
    "eslint-plugin-import": "^2.22.1",
    "eslint-plugin-jsx-a11y": "^6.4.1",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-react": "^7.21.5",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-webpack-plugin": "^4.2.0",
    "lerna": "^8.2.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.5.1",
    "webpack": "^5.97.1",
    "webpack-cli": "^4.5.0"
  },
  "packageManager": "yarn@4.6.0"
}
