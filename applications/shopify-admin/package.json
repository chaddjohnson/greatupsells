    "serverless-plugin-warmup": "^8.2.1"
  },
  "scripts": {
    "build": "NODE_OPTIONS=--openssl-legacy-provider next build",
    "format": "find src -type f -iname '*.js' -exec eslint --fix {} +",
    "lint": "eslint 'src/**/*.js'",
    "infrastructure": "cd infrastructure && ./run.sh",
    "destroy": "cd infrastructure && ./destroy.sh",
    "start": "nodemon -e js --exec \"NODE_OPTIONS=--openssl-legacy-provider NODE_TLS_REJECT_UNAUTHORIZED='0' node src/routes/server\" --watch src/routes",
    "shopify": "shopify",
    "extensions:build": "dotenv -- bash -c 'shopify app build'",
    "extensions:start": "dotenv -- bash -c 'shopify app dev'",
    "extensions:info": "shopify app info",
    "extensions:scaffold": "shopify app scaffold",
    "extensions:deploy": "shopify app deploy --force",
    "extensions:release": "shopify app release --force"
  }
}
